<%- include('../../partials/header') -%>

<style>
    .auth-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #3a86ff 0%, #4361ee 45%, #5a189a 100%);
        display: flex;
        align-items: center;
        padding: 2rem 0;
    }
    .auth-card {
        border: none;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 14px 34px rgba(0, 0, 0, 0.2);
    }
    .auth-card-header {
        background: rgba(255, 255, 255, 0.15);
        color: #1f2a44;
        padding: 1.25rem 1.5rem;
        border-bottom: 1px solid #eef2ff;
    }
    .auth-card-body { padding: 1.5rem; background-color: #fff; }
    .auth-btn {
        background: linear-gradient(90deg, #3a86ff, #4361ee);
        border: none;
        color: #fff;
        font-weight: 600;
    }
    .auth-btn:hover { opacity: 0.92; color: #fff; }
</style>

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-md-7 col-lg-5">
                <div class="card auth-card">
                    <div class="auth-card-header">
                        <h2 class="h4 fw-bold m-0">Login de admin</h2>
                    </div>
                    <div class="auth-card-body">
                        <% if (loginError) { %>
                            <div class="alert alert-warning" role="alert">
                                Email ou senha inválidos.
                            </div>
                        <% } %>
                        <form method="POST" action="/authenticate">
                            <input class="form-control mb-3" type="email" name="email" placeholder="Email" required>
                            <input class="form-control mb-3" type="password" name="password" placeholder="Senha" required>
                            <button class="btn auth-btn w-100" type="submit">Entrar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<%- include('../../partials/footer') -%>