<%- include('../../partials/header') -%>
<%- include('../../partials/navbar') -%>
<link rel="stylesheet" href="/css/admin-tables.css">

<div class="container py-4">
    <div class="card users-card">
        <div class="card-header users-card-header d-flex justify-content-between align-items-center py-3">
            <h2 class="h4 m-0">Usuários</h2>
            <a class="btn btn-light btn-sm fw-semibold" href="/admin/users/create">+ Novo usuário</a>
        </div>

        <div class="card-body p-0">
            <table class="table users-table table-hover m-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Id</th>
                        <th scope="col">Email</th>
                    </tr>
                </thead>
                <tbody>
                    <% users.forEach(user => { %>
                        <tr>
                            <td class="ps-4"><span class="id-badge">#<%= user.id %></span></td>
                            <td class="fw-semibold text-secondary"><%= user.email %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
</div>


<%- include('../../partials/footer') -%>