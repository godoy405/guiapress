<%- include('../../partials/header') -%>
<%- include('../../partials/navbar') -%>

<div class="container">
    <hr>
    <h2>Categorias</h2>
    <a class="btn btn-success" onclick="window.location.href='/admin/categories/new'">Nova Categoria</a>
    <hr>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Título</th>
                <th scope="col">Slug</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>  
        <tbody>            
            <% categories.forEach(category => { %>
                <tr>
                    <th><%= category.id %></th>
                    <th><%= category.title %></th>
                    <th><%= category.slug %></th>
                    <th>
                        <a href="/admin/categories/edit/<%= category.id %>" class="btn btn-warning">Editar</a>
                        <form action="/categories/delete" method="POST" style="display: inline;" onsubmit="confirmarDelecao(event, this)">
                            <input type="hidden" name="id" value="<%= category.id %>">
                            <button class="btn btn-danger">Excluir</button>
                        </form>
                        
                    </th>
                </tr>  
            <% }) %> 
        </tbody>      
    </table>
</div>

<%- include('../../partials/footer') -%>
<script>
    function confirmarDelecao(event, form){
        event.preventDefault();
        var decision = confirm('Tem certeza que deseja excluir esta categoria?');
        if(decision) {
            form.submit();
            }
    }    
</script>