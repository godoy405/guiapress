<%- include('../../partials/header') -%>
<%- include('../../partials/navbar') -%>

<style>
    .admin-card {
        border: none;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);
    }
    .admin-card-header {
        background: linear-gradient(90deg, #3a86ff, #4361ee);
        color: #fff;
    }
    .admin-table thead th {
        background-color: #f1f5ff;
        color: #3b4a77;
        border-bottom-width: 0;
    }
    .admin-table tbody tr:hover { background-color: #f8faff; }
    .id-badge {
        background-color: #4361ee;
        color: #fff;
        border-radius: 999px;
        padding: 0.3rem 0.65rem;
        font-weight: 600;
        font-size: 0.78rem;
    }
    .slug-badge {
        background-color: #eef2ff;
        color: #4f5d89;
        border-radius: 999px;
        padding: 0.25rem 0.6rem;
        font-size: 0.78rem;
    }
</style>

<div class="container py-4">
    <div class="card admin-card">
        <div class="card-header admin-card-header d-flex justify-content-between align-items-center py-3">
            <h2 class="h4 m-0">Categorias</h2>
            <a class="btn btn-light btn-sm fw-semibold" href="/admin/categories/new">+ Nova categoria</a>
        </div>

        <div class="card-body p-0">
            <table class="table admin-table table-hover m-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Id</th>
                        <th scope="col">Título</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(category => { %>
                        <tr>
                            <td class="ps-4"><span class="id-badge">#<%= category.id %></span></td>
                            <td class="fw-semibold text-secondary"><%= category.title %></td>
                            <td><span class="slug-badge"><%= category.slug %></span></td>
                            <td>
                                <a href="/admin/categories/edit/<%= category.id %>" class="btn btn-sm btn-outline-warning me-1">Editar</a>
                                <form action="/categories/delete" method="POST" style="display: inline;" onsubmit="confirmarDelecao(event, this)">
                                    <input type="hidden" name="id" value="<%= category.id %>">
                                    <button class="btn btn-sm btn-outline-danger">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../../partials/footer') -%>
<script>
    function confirmarDelecao(event, form){
        event.preventDefault();
        var decision = confirm('Tem certeza que deseja excluir esta categoria?');
        if(decision) {
            form.submit();
            }
    }    
</script>