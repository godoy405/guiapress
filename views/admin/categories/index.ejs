<%- include('../../partials/header') -%>
<%- include('../../partials/navbar') -%>
<link rel="stylesheet" href="/css/admin-tables.css">

<div class="container py-4">
    <div class="card admin-card">
        <div class="card-header admin-card-header d-flex justify-content-between align-items-center py-3">
            <h2 class="h4 m-0">Categorias</h2>
            <a class="btn btn-light btn-sm fw-semibold" href="/admin/categories/new">+ Nova categoria</a>
        </div>

        <div class="card-body p-0">
            <table class="table admin-table table-hover m-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Id</th>
                        <th scope="col">Título</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% categories.forEach(category => { %>
                        <tr>
                            <td class="ps-4"><span class="id-badge">#<%= category.id %></span></td>
                            <td class="fw-semibold text-secondary"><%= category.title %></td>
                            <td><span class="slug-badge"><%= category.slug %></span></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <a href="/admin/categories/edit/<%= category.id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                    <form action="/categories/delete" method="POST" class="m-0" onsubmit="confirmarDelecao(event, this)">
                                        <input type="hidden" name="id" value="<%= category.id %>">
                                        <button class="btn btn-sm btn-outline-danger">Excluir</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../../partials/footer') -%>
<script>
    function confirmarDelecao(event, form){
        event.preventDefault();
        var decision = confirm('Tem certeza que deseja excluir esta categoria?');
        if(decision) {
            form.submit();
            }
    }    
</script>