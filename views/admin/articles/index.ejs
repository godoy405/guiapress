<%- include('../../partials/header') -%>
<%- include('../../partials/navbar') -%>
<link rel="stylesheet" href="/css/admin-tables.css">

<div class="container py-4">
    <div class="card admin-card">
        <div class="card-header admin-card-header d-flex justify-content-between align-items-center py-3">
            <h2 class="h4 m-0">Artigos</h2>
            <a class="btn btn-light btn-sm fw-semibold" href="/admin/articles/new">+ Novo artigo</a>
        </div>

        <div class="card-body p-0">
            <table class="table admin-table table-hover m-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col" class="ps-4">Id</th>
                        <th scope="col">Título</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Categoria</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% articles.forEach(article => { %>
                        <tr>
                            <td class="ps-4"><span class="id-badge">#<%= article.id %></span></td>
                            <td class="fw-semibold text-secondary"><%= article.title %></td>
                            <td><span class="slug-badge"><%= article.slug %></span></td>
                            <td><%= article.category ? article.category.title : "-" %></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                <a href="/admin/articles/edit/<%= article.id %>" class="btn btn-sm btn-outline-warning">Editar</a>
                                <form action="/articles/delete" method="POST" class="m-0" onsubmit="confirmarDelecao(event, this)">
                                    <input type="hidden" name="id" value="<%= article.id %>">
                                    <button class="btn btn-sm btn-outline-danger">Excluir</button>
                                </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../../partials/footer') -%>

<script>
    function confirmarDelecao(event, form){
        event.preventDefault();
        var decision = confirm("Você quer deletar esse artigo ?");
        if(decision){
            form.submit();
        }
    }
</script>    
